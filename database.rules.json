{
  "rules": {
    ".read": false,
    ".write": false,
    "academic_settings": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'teacher')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "academic_events": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'teacher')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "school_settings": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'teacher')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "teachers": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $uid)",
        ".write": "auth != null && auth.token.role === 'admin'"
      }
    },
    "teacher_submissions": {
      ".read": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.token.role === 'admin' || auth.uid === $uid)",
        "$submissionId": {
          ".write": "auth != null && (auth.token.role === 'admin' || (auth.uid === $uid && !data.exists() && newData.child('teacherId').val() === auth.uid && newData.child('status').val() === 'Menunggu pemeriksaan'))"
        }
      }
    }
  }
}
